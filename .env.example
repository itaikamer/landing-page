# מעתיקים את הקובץ הזה לקובץ חדש בשם .env וממלאים.
# שני הערכים נמצאים ב-Supabase: Project Settings → Data API / API Keys
# המפתח הוא ה-publishable (מתחיל ב-sb_publishable_), לא הסודי
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_...
# המפתח הסודי - רק לדף הפניות (/admin). לא משתפים אותו עם אף אחד
SUPABASE_SECRET_KEY=sb_secret_...
